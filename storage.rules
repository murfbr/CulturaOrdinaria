rules_version = '2';

// Regras do Storage da Central do Coletivo.
// Publicação: cole no console (Storage → Rules → Publish), como as regras do Firestore.
//
// Quem tem conta (criada pelo coletivo no console) lê e grava os arquivos das
// páginas próprias de projeto, em paginas/<slug>/... Todo o resto fica fechado.
service firebase.storage {
  match /b/{bucket}/o {
    match /paginas/{resto=**} {
      allow read, write: if request.auth != null;
    }
    match /{resto=**} {
      allow read, write: if false;
    }
  }
}
