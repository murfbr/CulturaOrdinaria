{
  "redirects": [
    {
      "source": "/sambadeponta",
      "destination": "/pontadelanca/",
      "permanent": false
    },
    {
      "source": "/sambadeponta/",
      "destination": "/pontadelanca/",
      "permanent": false
    },
    {
      "source": "/sambadeponta/:caminho*",
      "destination": "/pontadelanca/:caminho*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pontadelanca/:caminho*",
      "destination": "/pontadelanca/index.html"
    },
    {
      "source": "/caminhosdoforro/:caminho*",
      "destination": "/caminhosdoforro/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
