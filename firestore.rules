rules_version = '2';

// Regras de segurança da Central do Coletivo.
// Deploy: `npm run regras` (ou cole no console: Firestore Database → Rules → Publish).
//
// Modelo de acesso combinado: quem tem conta (criada pelo coletivo no console,
// Authentication → Users) edita tudo; quem não tem conta não lê nada.
// As contas são o "muro" — não há papéis nem auto-cadastro.
//
// O coringa é recursivo ({document=**}) para cobrir também as subcoleções das
// páginas próprias de projeto (paginas/<slug>/edicoes); a permissão é a mesma
// da regra anterior, que só alcançava documentos na raiz.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
